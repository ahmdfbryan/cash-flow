# === Discord ===
DISCORD_TOKEN=isi_token_bot_kamu
CLIENT_ID=isi_application_id_bot
GUILD_ID=isi_id_server_kokokrunch
# User ID kamu (single-user, semua transaksi divalidasi milik user ini)
OWNER_ID=isi_discord_user_id_kamu

# === Channel Notifikasi (pisah per jenis, isi ID channel masing-masing) ===
# Kalau salah satu dikosongkan, notifikasi jenis itu akan fallback ke CHANNEL_DEFAULT
CHANNEL_DEFAULT=isi_id_channel_default
# Log setiap transaksi masuk/keluar/transfer
CHANNEL_TRANSAKSI=isi_id_channel_transaksi
# Warning budget mendekati/lewat limit
CHANNEL_BUDGET=isi_id_channel_budget
# Notif transaksi berulang (tagihan) tereksekusi otomatis
CHANNEL_RECURRING=isi_id_channel_recurring
# Laporan otomatis mingguan & bulanan
CHANNEL_LAPORAN=isi_id_channel_laporan
# Log error / status sistem bot (sync gagal, bot restart, dll)
CHANNEL_SYSTEM=isi_id_channel_system

# === Google Sheets ===
# ID spreadsheet, ambil dari URL: docs.google.com/spreadsheets/d/{INI_ID_NYA}/edit
GOOGLE_SHEET_ID=isi_id_spreadsheet
# Path ke file service account JSON (lihat README untuk cara bikin)
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# === Lain-lain ===
TIMEZONE=Asia/Jakarta
CURRENCY=IDR
